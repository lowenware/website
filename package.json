{
  "name": "lowenware-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "lint:md": "markdownlint -c markdownlint.json content/",
    "format": "prettier --write .",
    "redirects:nginx": "tsx scripts/generate-nginx-redirects.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/load-config": "^0.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "markdownlint": "^0.38.0",
    "markdownlint-cli": "^0.50.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@fontsource/jura": "^5.3.0",
    "dompurify": "^3.5.0",
    "gray-matter": "^4.0.3",
    "isomorphic-dompurify": "^2.23.0",
    "marked": "^15.0.8",
    "svelte-i18n": "^4.0.1",
    "zod": "^4.6.7"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
